# Arquivos de Dependências
# Ignora as pastas que guardam os pacotes instalados
/node_modules
/frontend/node_modules
/backend/node_modules

# Arquivos de Build
# Ignora as pastas que são geradas quando a gente "compila" o projeto
/dist
/frontend/dist
/backend/dist

# Logs
# Ignora arquivos de log de erros e crashes
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos de Variáveis de Ambiente
# MUITO IMPORTANTE: Nunca salve senhas ou chaves de API no Git!
.env
.env.local
.env.*.local

# Arquivos de Sistema Operacional
# Ignora arquivos inúteis que o Mac, Windows e Linux criam
.DS_Store
Thumbs.db

# Arquivos de Cache de Editores
.vscode/
.idea/